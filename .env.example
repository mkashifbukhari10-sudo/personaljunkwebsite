# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, robots, Open Graph and JSON-LD.
# Production value: https://junkservicesdubai.com (apex, no www).
#
# Safe to leave empty: on Vercel the site falls back to the deployment’s own
# .vercel.app domain, so it deploys and works without a custom domain. While it
# is empty the deployment is marked noindex (robots.txt disallows everything and
# every page carries a noindex tag), so a staging URL cannot compete with the
# real site later. Setting this is the single switch that turns indexing on.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery through Resend (app/(frontend)/api/quote/route.js).
# The API key from resend.com; the sender must be on a domain verified in Resend.
RESEND_API_KEY=
# Where pickup requests are delivered (comma-separate several addresses).
CONTACT_TO_EMAIL=
# Sender, e.g. "Junk Services Dubai <requests@junkservicesdubai.com>".
CONTACT_FROM_EMAIL=

# Plausible analytics (plan.md Phase 15). The domain exactly as registered in Plausible,
# e.g. junkservicesdubai.com. Leave empty and no analytics script is loaded at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for a self-hosted Plausible instance; defaults to https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Optional build worker limit (leave unset for Next defaults).
NEXT_BUILD_CPUS=
