# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, robots, Open Graph and JSON-LD.
# Production value: https://junkservicesdubai.com (apex, no www).
#
# Safe to leave empty: on Vercel the site falls back to the deployment’s own
# .vercel.app domain, so it deploys and works without a custom domain. While it
# is empty the deployment is marked noindex (robots.txt disallows everything and
# every page carries a noindex tag), so a staging URL cannot compete with the
# real site later. Setting this is the single switch that turns indexing on.
NEXT_PUBLIC_SITE_URL=

# Payload CMS (plan.md Phase 7). Generate the secret with: openssl rand -hex 32
PAYLOAD_SECRET=dd0e9e68f9b22fc47678138c89de36b7242f0496b060c4cd9d98380132694e25
# Postgres connection string (e.g. Neon / Vercel Postgres). Payload creates its tables on first run.
# Required: since the Phase 9 migration the site reads all of its content from Payload and
# cannot build without a database. Populate an empty one with: npm run seed
DATABASE_URI=postgresql://neondb_owner:npg_hocg2VMfPN9I@ep-orange-waterfall-aylnrn2y-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Vercel Blob store for uploaded images (plan.md Phase 10). Vercel sets this automatically
# once a Blob store is connected to the project; locally, copy it from the store’s settings.
# Leave empty to store uploads in the local media/ directory instead (development only).
BLOB_READ_WRITE_TOKEN=

# Shared secret for blog draft previews (plan.md Phase 13). Generate with: openssl rand -hex 32
# The admin's Preview button uses it; leave empty to disable preview entirely.
PREVIEW_SECRET=

# Plausible analytics (plan.md Phase 15). The domain exactly as registered in Plausible,
# e.g. junkservicesdubai.com. Leave empty and no analytics script is loaded at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for a self-hosted Plausible instance; defaults to https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Optional build worker limit (leave unset for Next defaults).
NEXT_BUILD_CPUS=
# Maintenance scripts can disable automatic development schema synchronization.
PAYLOAD_DISABLE_SCHEMA_PUSH=false
